# Copy to .env to change defaults. Nothing here is required: `docker compose up -d` works without a .env file.
# Never commit a real .env (it is git-ignored).

# Local port for the web UI. It is always bound to 127.0.0.1.
PYRAMID_PORT=8080

# Optional NVD API key (https://nvd.nist.gov/developers/request-an-api-key). Raises NVD rate limits; leave empty without one.
NVD_API_KEY=

# News collection: minutes between cycles, and how many feeds are downloaded at once (1-16).
NEWS_INTERVAL_MINUTES=30
NEWS_WORKERS=8

# 1 = fetch the small CISA KEV / FIRST EPSS files automatically when missing or stale (before and without the optional NVD import). 0 = manual only.
PYRAMID_AUTO_ENRICH=1
